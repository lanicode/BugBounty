#!/bin/bash

set -u

show_blocked_message() {
  /usr/bin/osascript -e 'display alert "Bug Bounty Copilot" message "Der lokale Start wurde sicher blockiert. Prüfe das Repository und führe danach den lokalen macOS-Installer erneut aus." as critical' >/dev/null 2>&1
}

fail() {
  show_blocked_message
  exit 1
}

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && /bin/pwd -P)" || fail
RESOURCES_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/../Resources" && /bin/pwd -P)" || fail

read_private_config() {
  CONFIG_PATH="$1"
  [ -f "$CONFIG_PATH" ] && [ ! -L "$CONFIG_PATH" ] || return 1
  [ "$(/usr/bin/stat -f '%Lp' "$CONFIG_PATH")" = "600" ] || return 1
  [ "$(/usr/bin/stat -f '%u' "$CONFIG_PATH")" = "$(/usr/bin/id -u)" ] || return 1
  exec 3< "$CONFIG_PATH" || return 1
  IFS= read -r CONFIG_VALUE <&3 || {
    exec 3<&-
    return 1
  }
  if [ -z "$CONFIG_VALUE" ]; then
    exec 3<&-
    return 1
  fi
  if IFS= read -r CONFIG_EXTRA <&3; then
    exec 3<&-
    return 1
  fi
  exec 3<&-
  case "$CONFIG_VALUE" in
    /*) return 0 ;;
    *) return 1 ;;
  esac
}

read_private_config "$RESOURCES_DIRECTORY/repository-path" || fail
REPOSITORY_ROOT="$CONFIG_VALUE"
read_private_config "$RESOURCES_DIRECTORY/node-path" || fail
NODE_EXECUTABLE="$CONFIG_VALUE"

[ -d "$REPOSITORY_ROOT" ] && [ ! -L "$REPOSITORY_ROOT" ] || fail
[ -f "$NODE_EXECUTABLE" ] && [ ! -L "$NODE_EXECUTABLE" ] &&
  [ -x "$NODE_EXECUTABLE" ] || fail
NODE_DIRECTORY="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$NODE_EXECUTABLE")" && /bin/pwd -P)" || fail
[ "$NODE_EXECUTABLE" = "$NODE_DIRECTORY/$(/usr/bin/basename -- "$NODE_EXECUTABLE")" ] || fail
[ -f "$REPOSITORY_ROOT/package.json" ] || fail
[ -f "$REPOSITORY_ROOT/node_modules/tsx/dist/cli.mjs" ] || fail
[ -f "$REPOSITORY_ROOT/apps/macos-launcher/index.ts" ] || fail
[ -f "$REPOSITORY_ROOT/apps/dashboard/index.ts" ] || fail
[ -f "$RESOURCES_DIRECTORY/integration-mode" ] || fail
[ -f "$RESOURCES_DIRECTORY/event-key-minimum-version" ] || fail
[ -f "$RESOURCES_DIRECTORY/operator-key-reference" ] || fail
[ -f "$RESOURCES_DIRECTORY/operator-id" ] || fail
[ -f "$RESOURCES_DIRECTORY/operator-key-revision" ] || fail

terminate_child() {
  if [ -n "${CHILD_PID:-}" ]; then
    /bin/kill -TERM "$CHILD_PID" >/dev/null 2>&1
    wait "$CHILD_PID" >/dev/null 2>&1
  fi
  exit 0
}
trap terminate_child HUP INT TERM

CDPATH= cd -- "$REPOSITORY_ROOT" || fail
/usr/bin/env -i PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
  "$NODE_EXECUTABLE" \
  "$REPOSITORY_ROOT/node_modules/tsx/dist/cli.mjs" \
  "$REPOSITORY_ROOT/apps/macos-launcher/index.ts" \
  "$RESOURCES_DIRECTORY" >/dev/null 2>&1 &
CHILD_PID=$!
wait "$CHILD_PID"
STATUS=$?
CHILD_PID=""
trap - HUP INT TERM

if [ "$STATUS" -ne 0 ]; then
  show_blocked_message
fi
exit "$STATUS"
