{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "program",
    "network",
    "capture",
    "accounts",
    "budgets",
    "forbidden",
    "policy_drift"
  ],
  "properties": {
    "version": { "const": 2 },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "handle",
        "display_name",
        "policy_source",
        "policy_hash_sha256",
        "policy_accepted_at",
        "policy_accepted_by"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "handle": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "policy_source": { "type": "string", "minLength": 1 },
        "policy_hash_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "policy_accepted_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "policy_accepted_by": { "type": ["string", "null"] }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "supporting_hosts",
        "deny_by_default",
        "allow_plain_http",
        "follow_redirects",
        "block_service_workers_during_capture"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        },
        "supporting_hosts": {
          "type": "array",
          "items": { "$ref": "#/$defs/support" }
        },
        "blocked_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deny_by_default": { "const": true },
        "allow_plain_http": { "type": "boolean" },
        "follow_redirects": { "const": false },
        "block_service_workers_during_capture": { "const": true }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persist_unredacted_traffic",
        "persist_response_bodies",
        "allowed_body_content_types",
        "max_body_bytes",
        "binary_handling",
        "websocket_capture",
        "stable_pseudonyms",
        "local_hmac_key_ref",
        "quarantine_unknown_identity_data"
      ],
      "properties": {
        "persist_unredacted_traffic": { "const": false },
        "persist_response_bodies": { "const": "selective" },
        "allowed_body_content_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "binary_handling": { "const": "hash_only" },
        "websocket_capture": { "type": "string" },
        "stable_pseudonyms": { "const": true },
        "local_hmac_key_ref": { "type": "string", "pattern": "^keychain://" },
        "quarantine_unknown_identity_data": { "const": true }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/account" }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_requests_per_minute",
        "max_concurrency",
        "max_requests_per_candidate",
        "max_state_changes_per_candidate",
        "stop_after_first_positive_signal",
        "cool_down_seconds_after_error",
        "stop_statuses"
      ],
      "properties": {
        "global_requests_per_minute": { "type": "integer", "minimum": 1 },
        "max_concurrency": { "const": 1 },
        "max_requests_per_candidate": { "type": "integer", "minimum": 1 },
        "max_state_changes_per_candidate": { "type": "integer", "minimum": 0 },
        "stop_after_first_positive_signal": { "const": true },
        "cool_down_seconds_after_error": { "type": "integer", "minimum": 0 },
        "stop_statuses": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "policy_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_campaign_when_policy_hash_changes",
        "require_new_acceptance"
      ],
      "properties": {
        "block_campaign_when_policy_hash_changes": { "const": true },
        "require_new_acceptance": { "const": true }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "ports", "path_prefixes"],
      "properties": {
        "scheme": { "enum": ["https", "http"] },
        "host": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "ports", "allowed_methods", "capture"],
      "properties": {
        "scheme": { "enum": ["https", "http"] },
        "host": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "OPTIONS", "POST"] }
        },
        "capture": { "enum": ["none", "metadata_only"] }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "secret_ref", "email_alias_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "secret_ref": { "type": "string", "pattern": "^keychain://" },
        "email_alias_ref": { "type": "string", "pattern": "^keychain://" }
      }
    }
  }
}
