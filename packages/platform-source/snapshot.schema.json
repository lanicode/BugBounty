{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "program", "policy", "network"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "source_revision", "retrieved_at"],
      "properties": {
        "kind": { "const": "offline_fixture" },
        "platform": { "const": "hackerone" },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "display_name"],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "supporting_hosts", "blocked_hosts"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/target" }
        },
        "supporting_hosts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/supporting" }
        },
        "blocked_hosts": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "ports", "path_prefixes"],
      "properties": {
        "scheme": { "const": "https" },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/"
          }
        }
      }
    },
    "supporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "ports", "allowed_methods", "capture"],
      "properties": {
        "scheme": { "const": "https" },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "OPTIONS"] }
        },
        "capture": { "enum": ["none", "metadata_only"] }
      }
    }
  }
}
