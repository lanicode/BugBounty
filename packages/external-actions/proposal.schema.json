{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proposal_id", "action_id", "mode", "parameters"],
  "properties": {
    "version": { "const": 2 },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "mode": { "enum": ["simulation", "external"] },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "campaign_ref",
        "campaign_revision",
        "campaign_digest",
        "policy_version",
        "policy_hash_sha256",
        "scope_ref",
        "account_ref",
        "account_role",
        "object_ref",
        "payload_ref",
        "approval_ref",
        "operator_ref"
      ],
      "properties": {
        "program_ref": { "$ref": "#/$defs/reference" },
        "campaign_ref": { "$ref": "#/$defs/reference" },
        "campaign_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "campaign_digest": { "$ref": "#/$defs/sha256" },
        "policy_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_hash_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope_ref": { "$ref": "#/$defs/reference" },
        "account_ref": { "$ref": "#/$defs/referenceOrNull" },
        "account_role": {
          "type": ["string", "null"],
          "enum": ["Owner", "Member", "External", null]
        },
        "object_ref": { "$ref": "#/$defs/referenceOrNull" },
        "payload_ref": { "$ref": "#/$defs/referenceOrNull" },
        "approval_ref": { "$ref": "#/$defs/reference" },
        "operator_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._@-]+$"
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "referenceOrNull": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
