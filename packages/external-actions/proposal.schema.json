{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proposal_id", "action_id", "mode", "parameters"],
  "properties": {
    "version": { "const": 1 },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "mode": { "enum": ["simulation", "external"] },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_ref",
        "policy_hash_sha256",
        "scope_ref",
        "account_ref",
        "object_ref",
        "payload_ref"
      ],
      "properties": {
        "campaign_ref": { "$ref": "#/$defs/referenceOrNull" },
        "policy_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_ref": { "$ref": "#/$defs/referenceOrNull" },
        "account_ref": { "$ref": "#/$defs/referenceOrNull" },
        "object_ref": { "$ref": "#/$defs/referenceOrNull" },
        "payload_ref": { "$ref": "#/$defs/referenceOrNull" }
      }
    }
  },
  "$defs": {
    "referenceOrNull": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
